# Maintainer: Transmit contributors <noreply@example.invalid>
pkgname=transmit
pkgver=0.1.0
pkgrel=1
pkgdesc="Move a computer's environment to one running another operating system"
arch=('x86_64' 'aarch64')
url="https://github.com/neramc/transmit"
license=('AGPL3')
depends=('qt6-base' 'qt6-declarative' 'zstd' 'xz' 'openssl' 'sqlite' 'libsecret')
makedepends=('cmake' 'ninja')
optdepends=('networkmanager: carrying wireless passwords across'
            'libsecret: storing passwords in the login keyring')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cmake -S "$pkgname-$pkgver" -B build -GNinja \
        -DCMAKE_BUILD_TYPE=RelWithDebInfo \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DTRANSMIT_BUILD_TESTS=ON
    cmake --build build
}

check() {
    ctest --test-dir build --output-on-failure
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -Dm644 "$pkgname-$pkgver/LICENSE.md" \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE.md"
}
